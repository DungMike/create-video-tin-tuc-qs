# ============== MATERIAL LIMITS ==============
MIN_VIDEO_CLIPS=30
MIN_IMAGE_CLIPS=30

# ============== TIMELINE CONTROL ==============
VID_CLIP_MIN_DURATION=3
VID_CLIP_MAX_DURATION=10
IMG_CLIP_DURATION=6

# ============== FFMPEG / RENDER ==============
TARGET_RESOLUTION=1920x1080
TARGET_FPS=30
USE_GPU_NVENC=true
FFMPEG_PRESET=p4
VIDEO_BITRATE=8M

# ============== CRAWLER ==============
YOUTUBE_DOWNLOAD_LIMIT_PER_KEYWORD=3
IMAGES_TO_DOWNLOAD_PER_KEYWORD=10
MAX_SOURCE_VIDEO_DURATION=600
CLIPS_PER_SOURCE_VIDEO=4

# ============== STORAGE ==============
STORAGE_DIR=./storage
OUTPUT_DIR=./storage/output

# ============== WEB APP ==============
WEB_HOST=127.0.0.1
WEB_PORT=5000
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=5174
FRONTEND_DIST_DIR=./frontend/dist
WEB_SECRET_KEY=change-me
MAX_UPLOAD_SIZE_MB=4096
