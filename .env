# ============== MATERIAL LIMITS ==============
MIN_VIDEO_CLIPS=30
MIN_IMAGE_CLIPS=30

# ============== TIMELINE CONTROL ==============
VID_CLIP_MIN_DURATION=5
VID_CLIP_MAX_DURATION=5
IMG_CLIP_DURATION=6
IMAGE_TRANSITION_DURATION=0.75
EFFECT_PREVIEW_CLIP_DURATION=2.25
IMAGE_ONLY_CHUNK_SEGMENT_LIMIT=80

# ============== FFMPEG / RENDER ==============
TARGET_RESOLUTION=1920x1080
TARGET_FPS=30
USE_GPU_NVENC=true
FFMPEG_PRESET=p4
VIDEO_BITRATE=8M
FFMPEG_COMMAND_TIMEOUT_SECONDS=0
FFMPEG_IMAGE_CLIP_TIMEOUT_SECONDS=120
IMAGE_MOTION_CACHE_ENABLED=true
IMAGE_MOTION_WORKERS=4
IMAGE_ONLY_FAST_CHUNK_CONCAT=true
IMAGE_ONLY_SKIP_XFADE=true
IMAGE_CLIP_FADE_DURATION=0.5

# ============== OVERLAY / WATERMARK ==============
ENABLE_OVERLAY=false
DECOR_VIDEOS_DIR=./storage/decor_videos
OVERLAY_VIDEO_POSITION=top_right
OVERLAY_VIDEO_SCALE=0.25
OVERLAY_VIDEO_MARGIN=10
SOURCE_TEXT=Nguồn: Tổng hợp
SOURCE_TEXT_1=Nguồn: Tổng hợp
SOURCE_TEXT_2=Источник: Сводные данные
SOURCE_TEXT_3=Source: Aggregated
SOURCE_TEXT_FONT_SIZE=28
SOURCE_TEXT_FONT=C:/Windows/Fonts/arial.ttf
SOURCE_TEXT_POSITION=bottom_left
SOURCE_TEXT_MARGIN=20
# Overlay performance tuning
# GPU overlay pipeline (overlay_cuda): auto-detected at runtime; each render falls
# back to the CPU overlay path if the GPU command fails. Verified working on this
# box (ffmpeg 8.1, GTX 1060): overlay compositing ~5x faster on GPU.
OVERLAY_USE_GPU_PIPELINE=true
# Split the GPU overlay+subtitle pass into N parallel time-segments (concat after).
# The subtitle burn (libass) is single-threaded/CPU-bound while the GPU is idle;
# running segments in parallel filled the GPU and cut the overlay stage ~317s -> ~174s
# (1.8x) on a 10-min render. 1 disables. Only used when a subtitle is present and the
# clip is >= OVERLAY_SEGMENT_MIN_SECONDS; any failure falls back to a single pass.
OVERLAY_PARALLEL_SEGMENTS=2
OVERLAY_SEGMENT_MIN_SECONDS=90
# Global cap on concurrent overlay ffmpeg processes (batch workers x segments).
# libass overlay is CPU-heavy/single-threaded; on a 4-core box, 2 batch workers x
# 2 segments = 4 processes saturated all cores and starved the GPU (~0.1x realtime).
# Keep this <= physical cores - 1 so segments/workers self-queue. 0 = auto (cpu-1).
OVERLAY_MAX_CONCURRENT=0
# Story batch: number of videos rendered concurrently. With overlay segmentation on,
# 1 keeps the per-video segments from oversubscribing CPU across parallel videos.
STORY_BATCH_MAX_WORKERS=1
# Clips baked concurrently when styling a library. Measured on this box (4 cores,
# GTX 1060): one retro_film clip costs ~2.6 CPU-s (3s clip) / ~4.1 (5s), and the
# GPU sits near-idle -- so throughput scales with cores, not NVENC. 3 leaves one
# core for the OS/Flask and stays within the card's 3 concurrent NVENC sessions
# (verified: 4800-clip normalize run at 3 sessions, 0 failures).
# A 30k-clip library: ~11.8h at 2 workers -> ~7.9h at 3.
STORY_BAKE_MAX_WORKERS=3
# Suspend these processes (comma-separated names) for the duration of a batch
# render, so render gets the CPU instead of competing with them; resumed as soon
# as the batch ends (success/failure/cancel), even on crash (see
# src/utils/render_priority.py; escape hatch: tests/benchmarks/resume_all.py).
# remoting_host.exe (Chrome Remote Desktop) is always excluded for safety.
RENDER_SUSPEND_PROCESS_NAMES=MktBrowser,tstfox,MKTLogin,TSTProfileManager
# While a batch render is active, bump spawned ffmpeg to Above-Normal OS priority.
RENDER_BOOST_FFMPEG_PRIORITY=true
# Story-library clips must match TARGET_RESOLUTION + these exactly (strict) to be
# selected -- otherwise a concatenated base mixing them can crash the GPU overlay
# pass mid-stream (NVDEC filter-graph reconfigure the CUDA-only chain can't bridge).
# Defaults = the dominant combo measured on the production library.
CLIP_EXPECTED_PIX_FMT=yuv420p
CLIP_EXPECTED_COLOR_RANGE=tv
CLIP_EXPECTED_COLOR_SPACE=bt709
# NVENC preset for overlay pass: p1=fastest, p7=slowest.
OVERLAY_NVENC_PRESET=p1
# Bitrate for overlay output. 4M is sufficient for news content.
OVERLAY_OUTPUT_BITRATE=4M
# CPU threads for overlay decode+filter (0=auto). Set to number of CPU cores.
OVERLAY_CPU_THREADS=0


# ============== OUTPUT ==============
OUTPUT_USE_AUDIO_FILENAME=true

# ============== CRAWLER ==============
YOUTUBE_DOWNLOAD_LIMIT_PER_KEYWORD=3
IMAGES_TO_DOWNLOAD_PER_KEYWORD=10
