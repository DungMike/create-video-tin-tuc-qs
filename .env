# ============== FFMPEG / RENDER ==============
TARGET_RESOLUTION=1920x1080
TARGET_FPS=30
USE_GPU_NVENC=true
FFMPEG_PRESET=p4
VIDEO_BITRATE=8M
FFMPEG_COMMAND_TIMEOUT_SECONDS=0
FFMPEG_IMAGE_CLIP_TIMEOUT_SECONDS=120
IMAGE_MOTION_CACHE_ENABLED=true
# 4 -> 8: was sized for a 4-core box; this one has 10 cores / 16 threads.
IMAGE_MOTION_WORKERS=8
IMAGE_ONLY_FAST_CHUNK_CONCAT=true
IMAGE_ONLY_SKIP_XFADE=true
IMAGE_CLIP_FADE_DURATION=0.5

# ============== OVERLAY / WATERMARK ==============
ENABLE_OVERLAY=false
# Bo trong -> tu suy ra tu STORAGE_DIR (D:/storage/decor_videos). Chi set lai neu
# muon dat decor videos o cho khac storage.
# DECOR_VIDEOS_DIR=
OVERLAY_VIDEO_POSITION=top_right
OVERLAY_VIDEO_SCALE=0.25
OVERLAY_VIDEO_MARGIN=10
SOURCE_TEXT=Nguá»“n: Tá»•ng há»£p
SOURCE_TEXT_1=Nguá»“n: Tá»•ng há»£p
SOURCE_TEXT_2=Ð˜ÑÑ‚Ð¾Ñ‡Ð½Ð¸Ðº: Ð¡Ð²Ð¾Ð´Ð½Ñ‹Ðµ Ð´Ð°Ð½Ð½Ñ‹Ðµ
SOURCE_TEXT_3=Source: Aggregated
SOURCE_TEXT_FONT_SIZE=28
SOURCE_TEXT_FONT=C:/Windows/Fonts/arial.ttf
SOURCE_TEXT_POSITION=bottom_left
SOURCE_TEXT_MARGIN=20
# Overlay performance tuning
# --- Retuned 2026-07-31 for this box: i5-14400F (10 cores / 16 threads, 32GB) +
# --- RTX 5060 8GB, ffmpeg 8.x. Previous values were tuned for a 4-core + GTX 1060.
# GPU overlay pipeline (overlay_cuda): auto-detected at runtime; each render falls
# back to the CPU overlay path if the GPU command fails. Measured here on the full
# chain (hwaccel cuda -> scale_cuda -> overlay_cuda -> hwdownload -> libass ass burn
# -> h264_nvenc p1): 12.2x realtime for a single 1080p30 pass.
OVERLAY_USE_GPU_PIPELINE=true
# Split the GPU overlay+subtitle pass into N parallel time-segments (concat after).
# The subtitle burn (libass) is single-threaded/CPU-bound while the GPU is idle;
# running segments in parallel fills the GPU. 1 disables. Only used when a subtitle
# is present and the clip is >= OVERLAY_SEGMENT_MIN_SECONDS; any failure falls back
# to a single pass. Kept at 2: with STORY_BATCH_MAX_WORKERS=3 this lands at the
# 6-process cap below, and whole-video parallelism (workers) beats segmentation
# because it has no concat step.
OVERLAY_PARALLEL_SEGMENTS=2
OVERLAY_SEGMENT_MIN_SECONDS=90
# Global cap on concurrent overlay ffmpeg processes (batch workers x segments).
# The libass burn is CPU-heavy/single-threaded, so this stage stops scaling well
# before the core count. Measured here (60s 1080p30 clip, 30 subtitle cues, same
# chain as above): 1 proc = 12.2x realtime, 3 = 25.6x, 6 = 30.6x -- i.e. 3 buys
# +110%, going 3->6 buys only +19% more while doubling per-video latency.
# 6 sits just past the knee and leaves cores for Flask/the OS.
# NOTE: do NOT set 0 (auto) on this box -- auto is os.cpu_count()-1 = 15 here,
# which would oversubscribe badly. See src/utils/story_video_pipeline.py.
OVERLAY_MAX_CONCURRENT=6
# Story batch: number of videos rendered concurrently. The old box was pinned to 1
# because 2 parallel videos saturated 4 cores on the CPU overlay path (benchmark:
# 2 videos took ~1053s vs ~1101s sequential, only ~4% faster). With the overlay now
# on the GPU and 10 cores available, 3 videos x 2 segments = the 6-process cap.
STORY_BATCH_MAX_WORKERS=3
# Clips baked concurrently when styling a library. Filter-bound on CPU with NVENC
# mostly idle, so throughput scales with cores. The old limit of 3 was set by the
# GTX 1060's 3 concurrent NVENC sessions; verified here that the RTX 5060 runs
# 10/10 parallel h264_nvenc sessions with 0 failures, so cores are the only limit
# now. 8 leaves 2 cores for the OS/Flask.
STORY_BAKE_MAX_WORKERS=8
# Suspend these processes (comma-separated names) for the duration of a batch
# render, so render gets the CPU instead of competing with them; resumed as soon
# as the batch ends (success/failure/cancel), even on crash (see
# src/utils/render_priority.py; escape hatch: tests/benchmarks/resume_all.py).
# remoting_host.exe (Chrome Remote Desktop) is always excluded for safety.
RENDER_SUSPEND_PROCESS_NAMES=MktBrowser,tstfox,MKTLogin,TSTProfileManager
# While a batch render is active, bump spawned ffmpeg to Above-Normal OS priority.
RENDER_BOOST_FFMPEG_PRIORITY=true
# Story-library clips must match TARGET_RESOLUTION + these exnpmactly (strict) to be
# selected -- otherwise a concatenated base mixing them can crash the GPU overlay
# pass mid-stream (NVDEC filter-graph reconfigure the CUDA-only chain can't bridge).
# Defaults = the dominant combo measured on the production library.
CLIP_EXPECTED_PIX_FMT=yuv420p
CLIP_EXPECTED_COLOR_RANGE=tv
CLIP_EXPECTED_COLOR_SPACE=bt709
# NVENC preset for overlay pass: p1=fastest, p7=slowest.
OVERLAY_NVENC_PRESET=p1
# Bitrate for overlay output. 4M is sufficient for news content.
OVERLAY_OUTPUT_BITRATE=4M
# CPU threads for overlay decode+filter (0=auto). Set to number of CPU cores.
OVERLAY_CPU_THREADS=0


# ============== OUTPUT ==============
OUTPUT_USE_AUDIO_FILENAME=true

# ============== CRAWLER ==============
YOUTUBE_DOWNLOAD_LIMIT_PER_KEYWORD=3
IMAGES_TO_DOWNLOAD_PER_KEYWORD=10
MAX_SOURCE_VIDEO_DURATION=600
CLIPS_PER_SOURCE_VIDEO=4

# ============== STORAGE ==============
# Hai o, hai vai tro:
#   C: (NVMe, 476GB)  = tap lam viec NONG cua render -> toc do
#   D: (HDD,   932GB) = luu tru CHINH + video thanh pham -> dung luong
#
# Do la ket qua do duoc 2026-08-04: toan bo storage nam tren HDD thi o D: bao hoa
# 100% (%idle cham 0, queue 3-8, latency doc 24-48ms) trong khi CPU chi 22-33% va
# NVENC 19-30%. Chuyen tap lam viec sang SSD: latency doc 24-48ms -> 0.9-1.2ms,
# %idle min 0% -> 78-93%, RTF tong 8.12x -> 12.50x (nhanh 1.54x). Chi tiet:
# tests/benchmarks/results/metrics_20260804_{230352=HDD,235733=SSD}.csv
#
# Moi duong dan con (story_library, story_video, story_cta_overlays, ...) tu suy ra
# tu STORAGE_DIR trong src/config.py, tru 2 cai duoc tach ra duoi day.
STORAGE_DIR=C:/storage
# Video thanh pham. Ghi 1 lan roi de do -> khong can o nhanh, va _finalize() remux
# thang tu C: ra day nen scratch tren SSD duoc xoa ngay sau moi video.
OUTPUT_DIR=D:/output
# Nguyen lieu nguon da tai/upload, TRUOC khi cat thanh clip thu vien. 61GB va chi
# tang dan; khong he duoc doc luc render (render doc story_library/<id>/clips/), nen
# de tren SSD khong mua duoc toc do nao ma chiem mat 61/476GB.
STORY_RAW_DIR=D:/storage/story_raw_videos
# Bo trong -> D:/storage/effects_library.
# EFFECTS_LIBRARY_DIR=
BATCH_RETRY_RETENTION_SECONDS=86400

