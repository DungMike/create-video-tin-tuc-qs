{"nodes": [{"id": "plan_edit_styles_edit_styles", "label": "Edit Styles (kieu dung) integration plan", "file_type": "document", "source_file": "PLAN_edit_styles.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Videos in a batch previously shared one layout; edit styles rotate per video so videos in the same batch differ. Delivered in 4 phases (2026-09-22 to 2026-09-28)."}, {"id": "plan_edit_styles_layouts", "label": "Layouts (bo cuc, one per video)", "file_type": "concept", "source_file": "PLAN_edit_styles.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "plain, tv_frame, tv_glass, tv_drift, card, letterbox, film_frame, osd_camcorder, osd_cctv, drift, magazine, split_accent, dossier, newsroom, album, doc_strip, tv_zoom, two_layer. Frame-shrinking layouts are blocked with libraries that have baked waveform/CTA; decor layouts require at least one decor image."}, {"id": "plan_edit_styles_modifiers", "label": "Modifiers (hieu ung bo tro)", "file_type": "concept", "source_file": "PLAN_edit_styles.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "cut_accents, long_takes, voice_bars, cta_moments, chapter_cards, quote_moments, light effects; stacked over the layout; at most one instance per kind per video."}, {"id": "plan_edit_styles_style_rotation", "label": "Style rotation (deal_rotation / deal_modifier_rotation)", "file_type": "concept", "source_file": "PLAN_edit_styles.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plan_edit_styles_edit_plan", "label": "EditPlan runtime (src/utils/edit_styles)", "file_type": "concept", "source_file": "PLAN_edit_styles.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Modules spec, store, graph (Ops(gpu) emits GPU or CPU filters for one graph), assets, chapters, runtime, preview; pipeline hooks EditPlan at clip choice, ASS build, extra inputs, filter segments, waveform/CTA placement."}, {"id": "plan_edit_styles_chapters_file", "label": "<audio>.chapters.txt chapter file", "file_type": "concept", "source_file": "PLAN_edit_styles.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lines 'time | title | label | quote', '>' lines are emphasis quotes; timestamps snap to nearest subtitle line; without file, chapters auto-split from SRT but no chapter text is shown."}, {"id": "plan_edit_styles_render_timeline", "label": "render_timeline (GPU static + CPU transition pieces)", "file_type": "concept", "source_file": "PLAN_edit_styles.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plan_edit_styles_light_fx", "label": "Light effects (light_sweep, light_leak, light_rays, spotlight)", "file_type": "concept", "source_file": "PLAN_edit_styles.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each effect is one cached pre-rendered PNG plus eval=frame x/y expressions with enable gating; costs 0-14% overlay time each."}, {"id": "plan_edit_styles_speed_threshold", "label": "Minimum 11x realtime speed rule", "file_type": "rationale", "source_file": "PLAN_edit_styles.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Styles below 11x were dropped: render-time Ken Burns (3.1x) and ambilight (10.5x). All 24 shipped styles measured 11.3x-18.4x on 10-minute audio."}, {"id": "plan_edit_styles_ken_burns_bake", "label": "Ken Burns baked in library bake", "file_type": "concept", "source_file": "PLAN_edit_styles.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Render-time Ken Burns was too slow (3.1x); baking adds under 1 s per clip and is stored in library metadata."}, {"id": "plan_edit_styles_balanced_tree_expr", "label": "Balanced-tree FFmpeg expression summation", "file_type": "rationale", "source_file": "PLAN_edit_styles.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Flat sum chains fail to parse beyond ~110 clauses while a 10-minute video has ~200 cut points."}, {"id": "plan_edit_styles_filter_script_file", "label": "Filter graph passed via -/filter_complex file", "file_type": "rationale", "source_file": "PLAN_edit_styles.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Avoids the 32K-character Windows command-line limit."}, {"id": "plan_edit_styles_ass_area_cost_rule", "label": "ASS cost-by-area rule (split drawings, single-frame PNG + eof_action=repeat)", "file_type": "rationale", "source_file": "PLAN_edit_styles.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "libass cost scales with drawn area, so ASS drawings are split into small pieces and timed toggles use one-frame PNG overlays."}, {"id": "plan_edit_styles_gpu_1088_bug", "label": "GPU overlay without subtitles outputs 1920x1088", "file_type": "concept", "source_file": "PLAN_edit_styles.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Known pre-existing bug in _gpu_overlay_tail scale_cuda branch: 8 green rows at bottom; subtitle branch (hwdownload + ASS) is correct 1080."}], "edges": [{"source": "plan_edit_styles_edit_styles", "target": "plan_edit_styles_layouts", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PLAN_edit_styles.md", "source_location": null, "weight": 1.0}, {"source": "plan_ed